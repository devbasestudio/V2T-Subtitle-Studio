{
  "name": "pda-subtitle-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:full": "concurrently \"npm:server\" \"npm:client\"",
    "client": "vite --host 0.0.0.0",
    "server": "node server/server.js",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "build:mac": "npm run build && electron-builder --mac dir",
    "start": "vite preview --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.556.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.phyodynamicacademy.pdav2t",
    "productName": "PDA V2T",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ]
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/**/*",
      "public/**/*",
      "!server/uploads/**",
      "!server/work/**",
      "build/icon.icns",
      "Samsung Myanmar.ttf",
      ".env",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg",
        "to": "bin/ffmpeg"
      },
      {
        "from": "node_modules/ffprobe-static/bin/darwin/arm64/ffprobe",
        "to": "bin/ffprobe"
      }
    ]
  }
}
